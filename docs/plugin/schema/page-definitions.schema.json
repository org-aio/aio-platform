{
  "$id": "https://raw.githubusercontent.com/zjarlin/aio-platform/main/docs/plugin/schema/page-definitions.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PageDocument",
  "description": "导航编写文档与已展开的页面协议共用一个接收入口。",
  "$comment": "AIO Plugin JSON contract aio:plugin@1.0.0",
  "anyOf": [
    {
      "$ref": "#/$defs/SceneTree"
    },
    {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SceneTree"
      }
    },
    {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PageDefinition"
      }
    }
  ],
  "$defs": {
    "MenuBranch": {
      "type": "object",
      "properties": {
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MenuNode"
          }
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "children"
      ]
    },
    "MenuGroupDefinition": {
      "description": "页面在当前场景菜单树中的一个目录节点。",
      "type": "object",
      "properties": {
        "icon": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ]
    },
    "MenuNode": {
      "anyOf": [
        {
          "$ref": "#/$defs/MenuBranch"
        },
        {
          "$ref": "#/$defs/MenuPage"
        }
      ]
    },
    "MenuPage": {
      "type": "object",
      "properties": {
        "body": {
          "$ref": "#/$defs/PageBody"
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "required_permission": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "body"
      ]
    },
    "PageActionDefinition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ]
    },
    "PageBody": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "entry": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "frontend"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "entry"
          ]
        },
        {
          "type": "object",
          "properties": {
            "button": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "counter"
            },
            "title": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "title",
            "button"
          ]
        },
        {
          "type": "object",
          "properties": {
            "content": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "text"
            },
            "title": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "title",
            "content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "actions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PageActionDefinition"
              }
            },
            "content": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "actions"
            },
            "state": {
              "type": "object",
              "additionalProperties": true,
              "default": {}
            },
            "title": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "title",
            "content",
            "actions"
          ]
        }
      ]
    },
    "PageDefinition": {
      "type": "object",
      "properties": {
        "body": {
          "$ref": "#/$defs/PageBody"
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "menu_path": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/MenuGroupDefinition"
          }
        },
        "required_permission": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "scene": {
          "$ref": "#/$defs/SceneDefinition"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "scene",
        "body"
      ]
    },
    "SceneDefinition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ]
    },
    "SceneTree": {
      "type": "object",
      "properties": {
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MenuNode"
          }
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "children"
      ]
    }
  }
}
